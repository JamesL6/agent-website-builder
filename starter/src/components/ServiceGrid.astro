---
/**
 * Services grid — variant `image_overlay_grid` (archetype §6).
 * Rich cards: photo panel with audience chips, bold title, description, accent link.
 * Until the shared image components land (§18), `image` accepts a prepared src;
 * cards without one render a branded gradient panel — never a bare gray box.
 */
interface ServiceCard {
  title: string;
  description: string;
  url: string;
  chips?: string[];
  image?: string;
  imageAlt?: string;
}

interface Props {
  eyebrow: string;
  heading: string;
  intro?: string;
  services: ServiceCard[];
  id?: string;
}

const { eyebrow, heading, intro, services, id = 'services' } = Astro.props;
---

<section class="bg-surface py-16 md:py-20" id={id}>
  <div class="mx-auto max-w-7xl px-4 md:px-6">
    <p class="text-xs font-bold uppercase tracking-eyebrow text-accent">{eyebrow}</p>
    <h2 class="mt-3 max-w-2xl font-display text-4xl font-bold text-ink md:text-5xl">{heading}</h2>
    {intro && <p class="mt-4 max-w-2xl text-ink-muted">{intro}</p>}

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((svc) => (
        <article class="group flex flex-col overflow-hidden rounded-md border border-border bg-white shadow-sm transition hover:shadow-md">
          <div class="relative aspect-[16/9] overflow-hidden">
            {svc.image ? (
              <img
                src={svc.image}
                alt={svc.imageAlt ?? ''}
                width="640"
                height="360"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]"
              />
            ) : (
              <div
                class="h-full w-full bg-dark"
                style="background-image: linear-gradient(135deg, var(--color-dark) 0%, var(--color-dark-3) 60%, var(--color-dark-2) 100%);"
                aria-hidden="true"
              >
              </div>
            )}
            {svc.chips && svc.chips.length > 0 && (
              <div class="absolute right-2 top-2 flex gap-1.5">
                {svc.chips.map((chip) => (
                  <span class="rounded-sm bg-dark/70 px-2 py-1 text-xs font-semibold text-white">{chip}</span>
                ))}
              </div>
            )}
          </div>

          <div class="flex flex-1 flex-col p-6">
            <h3 class="font-display text-2xl font-bold text-ink">{svc.title}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-muted">{svc.description}</p>
            <a href={svc.url} class="mt-4 inline-flex items-center gap-1.5 text-sm font-bold text-accent transition group-hover:gap-2.5">
              Learn More
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
