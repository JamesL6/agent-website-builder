---
/**
 * Shared request-service form panel (§11). Brand-color header, emergency callout with
 * visible phone, fixed field set with natural row pairing, full-width submit.
 * Form action/routing is wired per client at build time — never hard-coded here.
 */
import { site } from '../data/site';
---

<div class="overflow-hidden rounded-md bg-white text-ink shadow-xl">
  <div class="bg-accent px-6 py-5 text-white">
    <h2 class="font-display text-3xl font-bold">Request Service</h2>
    <p class="mt-1 text-sm text-white/90">Non-emergency requests are returned within one business day.</p>
  </div>

  <div class="space-y-4 p-6">
    <p class="rounded-sm border-l-4 border-accent bg-surface px-4 py-3 text-sm leading-snug">
      <strong>Currently experiencing an emergency?</strong>
      {' '}Call{' '}
      <a href={site.phoneHref} class="font-bold text-accent whitespace-nowrap">{site.phoneDisplay}</a>
      {' '}now for immediate assistance.
    </p>

    <form class="space-y-4" method="post" action="#">
      <div>
        <label for="rs-name" class="mb-1 block text-xs font-bold uppercase tracking-wide text-ink-muted">Name *</label>
        <input id="rs-name" name="name" type="text" required autocomplete="name" placeholder="Your name"
          class="w-full rounded-sm border border-border px-3 py-2.5 text-sm outline-none transition focus:border-accent" />
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <label for="rs-phone" class="mb-1 block text-xs font-bold uppercase tracking-wide text-ink-muted">Phone *</label>
          <input id="rs-phone" name="phone" type="tel" required autocomplete="tel" placeholder="(555) 000-0000"
            class="w-full rounded-sm border border-border px-3 py-2.5 text-sm outline-none transition focus:border-accent" />
        </div>
        <div>
          <label for="rs-email" class="mb-1 block text-xs font-bold uppercase tracking-wide text-ink-muted">Email *</label>
          <input id="rs-email" name="email" type="email" required autocomplete="email" placeholder="your@email.com"
            class="w-full rounded-sm border border-border px-3 py-2.5 text-sm outline-none transition focus:border-accent" />
        </div>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <label for="rs-service" class="mb-1 block text-xs font-bold uppercase tracking-wide text-ink-muted">Service needed *</label>
          <select id="rs-service" name="service" required
            class="w-full rounded-sm border border-border bg-white px-3 py-2.5 text-sm outline-none transition focus:border-accent">
            <option value="" selected disabled>Select a service…</option>
            {site.services.map((s) => <option value={s.id}>{s.label}</option>)}
            <option value="other">Something else</option>
          </select>
        </div>
        <div>
          <label for="rs-city" class="mb-1 block text-xs font-bold uppercase tracking-wide text-ink-muted">City or ZIP *</label>
          <input id="rs-city" name="city" type="text" required autocomplete="postal-code" placeholder={`${site.primaryMarket} or ZIP`}
            class="w-full rounded-sm border border-border px-3 py-2.5 text-sm outline-none transition focus:border-accent" />
        </div>
      </div>

      <div>
        <label for="rs-message" class="mb-1 block text-xs font-bold uppercase tracking-wide text-ink-muted">Additional information (optional)</label>
        <textarea id="rs-message" name="message" rows="3" placeholder="Tell us what happened, if you have time…"
          class="w-full rounded-sm border border-border px-3 py-2.5 text-sm outline-none transition focus:border-accent"></textarea>
      </div>

      <button type="submit"
        class="w-full rounded-md bg-accent py-3.5 font-bold text-white shadow-md transition hover:bg-accent-hover">
        Send Service Request →
      </button>
    </form>
  </div>
</div>
