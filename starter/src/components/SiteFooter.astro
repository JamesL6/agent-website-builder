---
/**
 * Footer — variant `full_nap_service_footer` (archetype §17).
 * Brand column with phone, service links, service-area links, company links,
 * NAP location cards (must match approved GBP data exactly, §13), legal bar.
 */
import { site } from '../data/site';

interface FooterLink {
  label: string;
  url: string;
}

interface Props {
  blurb: string;
  areaLinks?: FooterLink[];
  companyLinks?: FooterLink[];
}

const {
  blurb,
  areaLinks = [],
  companyLinks = site.nav.filter((n) => n.url !== '/'),
} = Astro.props;

const year = new Date().getFullYear();
---

<footer class="border-t-2 border-accent bg-dark text-on-dark">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:grid-cols-2 md:px-6 lg:grid-cols-4">
    <div>
      <p class="font-display text-2xl font-bold">{site.name}</p>
      <p class="mt-3 text-sm leading-relaxed text-on-dark/70">{blurb}</p>
      <a
        href={site.phoneHref}
        class="mt-5 inline-flex items-center gap-2 rounded-md bg-accent px-5 py-3 font-bold text-white transition hover:bg-accent-hover"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z" />
        </svg>
        {site.phoneDisplay}
      </a>
    </div>

    <nav aria-label="Footer services">
      <h3 class="text-xs font-bold uppercase tracking-eyebrow text-on-dark/50">Services</h3>
      <ul class="mt-4 space-y-2.5 text-sm">
        {site.services.map((svc) => (
          <li><a href={svc.url} class="text-on-dark/80 transition hover:text-accent-bright">{svc.label}</a></li>
        ))}
      </ul>
    </nav>

    <nav aria-label="Footer service areas">
      <h3 class="text-xs font-bold uppercase tracking-eyebrow text-on-dark/50">Service Areas</h3>
      <ul class="mt-4 space-y-2.5 text-sm">
        {areaLinks.length > 0 ? (
          areaLinks.map((link) => (
            <li><a href={link.url} class="text-on-dark/80 transition hover:text-accent-bright">{link.label}</a></li>
          ))
        ) : (
          <li class="text-on-dark/60">Serving {site.primaryMarket} and surrounding communities.</li>
        )}
      </ul>
    </nav>

    <nav aria-label="Footer company">
      <h3 class="text-xs font-bold uppercase tracking-eyebrow text-on-dark/50">Company</h3>
      <ul class="mt-4 space-y-2.5 text-sm">
        {companyLinks.map((link) => (
          <li><a href={link.url} class="text-on-dark/80 transition hover:text-accent-bright">{link.label}</a></li>
        ))}
        {site.socialLinks.map((social) => (
          <li>
            <a href={social.url} rel="noopener noreferrer" target="_blank" class="text-on-dark/80 transition hover:text-accent-bright">
              {social.platform}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  {site.locations.length > 0 && (
    <div class="border-t border-dark-3">
      <div class="mx-auto grid max-w-7xl gap-4 px-4 py-8 sm:grid-cols-2 md:px-6 lg:grid-cols-3">
        {site.locations.map((loc) => (
          <div class="rounded-md border border-dark-3 bg-dark-2 p-5">
            <h3 class="font-display text-lg font-bold">{loc.name}</h3>
            <p class="mt-1 text-sm text-on-dark/70">{loc.address}</p>
            <a href={`tel:${loc.phone.replace(/[^+\d]/g, '')}`} class="mt-2 inline-block text-sm font-bold text-accent-bright">
              {loc.phone}
            </a>
          </div>
        ))}
      </div>
    </div>
  )}

  <div class="border-t border-dark-3">
    <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-2 px-4 py-5 text-xs text-on-dark/50 sm:flex-row md:px-6">
      <p>© {year} {site.legalName}. All rights reserved.</p>
      <p class="flex gap-4">
        <a href="/privacy-policy/" class="transition hover:text-on-dark">Privacy Policy</a>
        <a href="/terms/" class="transition hover:text-on-dark">Terms</a>
      </p>
    </div>
  </div>
</footer>
