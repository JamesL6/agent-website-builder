---
/**
 * Body module `inner-subsections` (§12): H3 support cards inside long SEO copy.
 * Cards may carry an internal link + compact "Learn more" when the brief calls
 * for child-page routing — never unrelated link cards to fill space.
 */
interface Subsection {
  title: string;
  text: string;
  url?: string;
  linkLabel?: string;
}

interface Props {
  items: Subsection[];
}

const { items } = Astro.props;
---

<div class="not-article my-8 grid gap-4 sm:grid-cols-2">
  {items.map((item) => (
    <article class="rounded-md border border-border bg-white p-6 shadow-sm">
      <h3 class="font-display text-lg font-bold text-ink">{item.title}</h3>
      <p class="mt-2 text-sm leading-relaxed text-ink-muted">{item.text}</p>
      {item.url && (
        <a href={item.url} class="mt-3 inline-flex items-center gap-1.5 text-sm font-bold text-accent">
          {item.linkLabel ?? 'Learn more'}
          <span aria-hidden="true">→</span>
        </a>
      )}
    </article>
  ))}
</div>
