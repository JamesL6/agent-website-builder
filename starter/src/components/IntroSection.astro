---
/**
 * Company intro/about — REQUIRED on the default homepage, directly after the
 * emergency band and before the services grid (James, 2026-08-25). Short intro:
 * eyebrow, heading, 1-2 paragraphs, benefit checks, phone-first CTA, and a
 * media panel (client photo/video when assets exist; branded placeholder until
 * then). Copy arrives from the Messaging Pack — none lives here.
 */
import type { ImageMetadata } from 'astro';
import { site } from '../data/site';
import OptimizedImage from './OptimizedImage.astro';

interface Props {
  eyebrow: string;
  heading: string;
  paragraphs: string[];
  benefits?: string[];
  /** Client team/truck/job photo (imported image). Placeholder panel without it. */
  image?: ImageMetadata;
  imageAlt?: string;
}

const { eyebrow, heading, paragraphs, benefits = [], image, imageAlt = '' } = Astro.props;
---

<section class="bg-white py-16 md:py-20">
  <div class="intro-grid mx-auto max-w-7xl items-center gap-10 px-4 md:px-6 lg:gap-16">
    <div class="intro-head">
      <p class="text-xs font-bold uppercase tracking-eyebrow text-accent">{eyebrow}</p>
      <h2 class="mt-3 font-display text-4xl font-bold text-ink md:text-5xl">{heading}</h2>
    </div>

    <div class="intro-body">
      {paragraphs.map((p) => <p class="mt-4 leading-relaxed text-ink-muted first:mt-0">{p}</p>)}

      {benefits.length > 0 && (
        <ul class="mt-6 grid gap-x-8 gap-y-2.5 sm:grid-cols-2">
          {benefits.map((b) => (
            <li class="flex items-center gap-2.5 text-sm font-semibold text-ink">
              <span class="inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-accent" aria-hidden="true">
                <svg class="size-3 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12.5l4.5 4.5L19 7.5" />
                </svg>
              </span>
              {b}
            </li>
          ))}
        </ul>
      )}

      <div class="mt-8 flex flex-wrap gap-4">
        <a href={site.phoneHref} class="inline-flex items-center gap-2.5 rounded-md bg-accent px-6 py-3.5 font-bold text-white shadow-md transition hover:bg-accent-hover">
          <svg class="size-4.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z" />
          </svg>
          <span class="hidden sm:inline">Call {site.phoneDisplay}</span>
          <span class="sm:hidden">Call Now</span>
        </a>
        <a href="#request-service" class="inline-flex items-center rounded-md border border-border px-6 py-3.5 font-bold text-ink transition hover:border-ink">
          Request Service
        </a>
      </div>
    </div>

    <div class="intro-media-col relative overflow-hidden rounded-md shadow-lg">
      {image ? (
        <OptimizedImage
          src={image}
          alt={imageAlt}
          widths={[640, 900, 1200]}
          sizes="(min-width: 1024px) 45vw, 100vw"
          class="h-full w-full object-cover"
        />
      ) : (
        <div
          class="flex aspect-[4/3] w-full items-end bg-dark p-6"
          style="background-image: linear-gradient(135deg, var(--color-dark) 0%, var(--color-dark-3) 55%, var(--color-dark-2) 100%);"
        >
          <p class="font-display text-2xl font-bold text-on-dark/40">{site.name}</p>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  /*
   * Mobile reading order: eyebrow + heading, then the PHOTO, then the detail copy.
   * Seeing the work immediately under the title does more for a homeowner than another
   * paragraph does. Desktop keeps the classic two-column split.
   */
  .intro-grid {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas:
      'head'
      'media'
      'body';
  }
  .intro-head  { grid-area: head; }
  .intro-media-col { grid-area: media; }
  .intro-body  { grid-area: body; }

  @media (min-width: 1024px) {
    .intro-grid {
      grid-template-columns: 1.1fr 1fr;
      grid-template-areas:
        'head media'
        'body media';
      align-content: center;
    }
  }
</style>

<style>
  /*
   * The WRAPPER owns the aspect ratio — it is the visible box carrying the radius and
   * shadow. The image fills it via utility classes (h-full w-full object-cover) on the
   * component's `class` prop, NOT via a scoped rule: Astro scoped styles do not reach an
   * <img> rendered inside a child component, so a scoped rule here is silently dead.
   */
  .intro-media-col {
    aspect-ratio: 4 / 3;
  }
</style>
