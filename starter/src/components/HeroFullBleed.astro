---
/**
 * Hero — variant `premium_full_bleed` (archetype candidate #4).
 * Full-bleed image treatment with centered content: eyebrow, display H1 with
 * accent word, subhead, trust chips row, dual phone-first CTA (§9).
 * No side form — pages using this variant must place the shared
 * RequestServicePanel in the section immediately after the hero (§11).
 * Until client photos land (§18), a layered gradient stands in for the image.
 */
import { site } from '../data/site';

interface H1Line {
  text: string;
  accent?: boolean;
}

interface Props {
  eyebrow: string;
  h1Lines: H1Line[];
  subhead: string;
  /** 4-6 short conversion facts. Keep each to ~2-4 words: long bullets wrap and
   *  break the grid rhythm. Sourced from the Messaging Pack, never invented. */
  trustChips: string[];
  secondaryCtaLabel?: string;
  /** Prepared hero image src — rendered as a dimmed full-bleed backdrop. */
  backgroundImage?: string;
}

const { eyebrow, h1Lines, subhead, trustChips, secondaryCtaLabel = 'Request Service', backgroundImage } = Astro.props;
---

<section class="relative overflow-hidden bg-dark text-on-dark" data-page-hero>
  {backgroundImage ? (
    <div class="absolute inset-0 bg-cover bg-center opacity-30" style={`background-image: url('${backgroundImage}');`} aria-hidden="true"></div>
  ) : (
    <div
      class="absolute inset-0"
      style="background-image: radial-gradient(ellipse 90% 70% at 50% 110%, var(--color-dark-3) 0%, transparent 60%), radial-gradient(ellipse 70% 50% at 80% -10%, var(--color-dark-2) 0%, transparent 55%);"
      aria-hidden="true"
    >
    </div>
  )}
  <div class="absolute inset-0 bg-gradient-to-b from-dark/70 via-transparent to-dark" aria-hidden="true"></div>

  <!--
    Mobile density is deliberately tight here: a centered full-bleed stack
    (eyebrow + 3-line H1 + subhead + chips) will push the phone CTA off screen
    at 390x844 otherwise, which fails §24. Do not loosen the mobile padding,
    subhead size, or chip grid without re-checking CTA position at 375px.
  -->
  <div class="relative mx-auto flex max-w-4xl flex-col items-center justify-center px-4 py-12 text-center md:min-h-[640px] md:px-6 md:py-28">
    <p class="inline-flex items-center gap-2 rounded-full border border-dark-3 bg-dark-2/80 px-4 py-2 text-xs font-bold uppercase tracking-eyebrow text-on-dark/90">
      <svg class="size-3.5 text-accent-bright" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.2 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8L12 2z" />
      </svg>
      {eyebrow}
    </p>

    <h1 class="mt-5 font-display text-4xl font-bold leading-none sm:text-6xl md:mt-7 xl:text-7xl">
      {h1Lines.map((line) => (
        <span class:list={['block md:whitespace-nowrap', { 'text-accent-bright': line.accent }]}>{line.text}</span>
      ))}
    </h1>

    <p class="mt-4 max-w-2xl text-on-dark/80 md:mt-6 md:text-lg">{subhead}</p>

    <!--
      Aligned check rows, NOT bordered pills. Pills force equal-width cells, so
      uneven bullet lengths produce ragged boxes of different heights. Aligned
      checkmarks let text of any length read as intentional. Centered inline-grid
      keeps the block centered while each row stays left-aligned.
    -->
    <ul class="mt-6 inline-grid gap-x-8 gap-y-2.5 text-left sm:grid-cols-2 md:mt-8">
      {trustChips.map((chip) => (
        <li class="flex items-start gap-2.5 text-sm font-semibold sm:items-center sm:text-base">
          <span class="mt-0.5 inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-accent sm:mt-0" aria-hidden="true">
            <svg class="size-3 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12.5l4.5 4.5L19 7.5" />
            </svg>
          </span>
          {chip}
        </li>
      ))}
    </ul>

    <div class="mt-7 flex flex-wrap justify-center gap-3 md:mt-10 md:gap-4">
      <a
        href={site.phoneHref}
        class="inline-flex items-center gap-3 rounded-md bg-accent px-8 py-4 text-lg font-bold text-white shadow-lg transition hover:bg-accent-hover"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z" />
        </svg>
        <span class="hidden sm:inline">Call Now — {site.phoneDisplay}</span>
        <span class="sm:hidden">Call Now</span>
      </a>
      <a
        href="#request-service"
        class="inline-flex items-center rounded-md border-2 border-on-dark/30 px-8 py-4 text-lg font-bold text-on-dark transition hover:border-on-dark/70"
      >
        {secondaryCtaLabel}
      </a>
    </div>
  </div>
</section>
