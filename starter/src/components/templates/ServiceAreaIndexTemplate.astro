---
/**
 * Service-area index (/service-area/) — the crawlable list every city hub hangs off (§14, §15).
 * Compact hero → the SAME shared service-area map the homepage renders (site.serviceArea) →
 * counties → city hub links → that city's approved city-service links. Every link comes from
 * shared site data, so this page, the map, the footer, and schema cannot disagree.
 */
import PageHero from '../PageHero.astro';
import ServiceAreaMap from '../ServiceAreaMap.astro';
import InlineCTA from '../InlineCTA.astro';
import { site } from '../../data/site';

interface Props {
  eyebrow: string;
  h1: string;
  intro?: string;
  listHeading: string;
  ctaHeading: string;
  ctaSupport: string;
}
const { eyebrow, h1, intro, listHeading, ctaHeading, ctaSupport } = Astro.props;
---

<PageHero eyebrow={eyebrow} h1={h1} intro={intro} />

<ServiceAreaMap {...site.serviceArea} mapCaption={site.serviceArea.caption} />

<section class="bg-surface py-14 md:py-20">
  <div class="mx-auto max-w-6xl px-4 md:px-6">
    <h2 class="font-display text-3xl font-bold text-ink">{listHeading}</h2>
    <div class="mt-8 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {site.serviceArea.counties.map((county) => (
        <div class="rounded-md border border-border bg-white p-6 shadow-sm">
          <h3 class="text-xs font-bold uppercase tracking-eyebrow text-ink-muted">{county.name}</h3>
          <ul class="mt-4 space-y-4">
            {county.cities.map((city) => (
              <li>
                <a href={city.url} class="font-display text-lg font-bold text-ink underline-offset-3 hover:text-accent hover:underline">{city.name}</a>
                {city.services?.length > 0 && (
                  <ul class="mt-1.5 flex flex-wrap gap-x-3 gap-y-1 text-sm">
                    {city.services.map((s) => (
                      <li><a href={s.url} class="text-ink-muted hover:text-accent">{s.label.replace(`${city.name} `, '')}</a></li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="mt-12">
      <InlineCTA heading={ctaHeading} support={ctaSupport} />
    </div>
  </div>
</section>
