---
/**
 * Service-area index (/service-area/) — the crawlable hub for the CITY HUB pages (§14, §15).
 * Compact hero → the SAME shared service-area map the homepage renders (site.serviceArea), with
 * the county → city accordion but WITHOUT per-city service expanders → phone-first CTA.
 *
 * Hub-and-spoke (owner decision 2026-09-09): this page links city hubs only; each city hub links
 * its own city-service pages. No city-service links here (at 50 cities × 32 services that is a
 * 1,600-link dump, §15) and no separate "cities by county" list (it duplicated the accordion).
 * Every link comes from shared site data, so this page, the map, the footer, and schema agree.
 */
import PageHero from '../PageHero.astro';
import ServiceAreaMap from '../ServiceAreaMap.astro';
import InlineCTA from '../InlineCTA.astro';
import { site } from '../../data/site';

interface Props {
  eyebrow: string;
  h1: string;
  intro?: string;
  ctaHeading: string;
  ctaSupport: string;
}
const { eyebrow, h1, intro, ctaHeading, ctaSupport } = Astro.props;
---

<PageHero eyebrow={eyebrow} h1={h1} intro={intro} />

<ServiceAreaMap {...site.serviceArea} mapCaption={site.serviceArea.caption} showCityServices={false} />

<section class="bg-surface py-12 md:py-16">
  <div class="mx-auto max-w-6xl px-4 md:px-6">
    <InlineCTA heading={ctaHeading} support={ctaSupport} />
  </div>
</section>
