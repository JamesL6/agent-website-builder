---
/**
 * Blog index (/blog/) — a plain, fast list of posts. Post data comes from a shared data file
 * (e.g. src/data/posts.ts); this template never invents titles or dates.
 */
import PageHero from '../PageHero.astro';
import OptimizedImage from '../OptimizedImage.astro';
import type { ImageMetadata } from 'astro';

export interface PostSummary {
  title: string;
  url: string;
  excerpt: string;
  /** ISO date string. */
  date: string;
  image?: ImageMetadata;
  imageAlt?: string;
}
interface Props {
  eyebrow: string;
  h1: string;
  intro?: string;
  posts: PostSummary[];
}
const { eyebrow, h1, intro, posts } = Astro.props;
const fmt = (d: string) => new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<PageHero eyebrow={eyebrow} h1={h1} intro={intro} />

<section class="bg-surface py-12 md:py-16">
  <ul class="mx-auto grid max-w-6xl gap-8 px-4 md:grid-cols-2 md:px-6 lg:grid-cols-3">
    {posts.map((p) => (
      <li class="flex flex-col overflow-hidden rounded-md border border-border bg-white shadow-sm">
        {p.image && <OptimizedImage src={p.image} alt={p.imageAlt ?? ''} class="aspect-[16/9] w-full object-cover" />}
        <div class="flex flex-1 flex-col p-6">
          <time datetime={p.date} class="text-xs font-bold uppercase tracking-eyebrow text-ink-muted">{fmt(p.date)}</time>
          <h2 class="mt-2 font-display text-xl font-bold leading-tight text-ink"><a href={p.url} class="hover:text-accent">{p.title}</a></h2>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-muted">{p.excerpt}</p>
          <a href={p.url} class="mt-4 text-sm font-bold text-accent">Read more &rarr;</a>
        </div>
      </li>
    ))}
  </ul>
</section>
