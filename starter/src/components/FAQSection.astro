---
/**
 * FAQ — variant `premium_cards_sticky_intro` treatment, simplified to centered
 * intro + accordion cards (archetype §14). Open card gets the accent border.
 * FAQ copy arrives from the brief/Messaging Pack — the first answer should put
 * the phone number inline for the 24/7 question.
 */
interface FAQ {
  question: string;
  answer: string;
}

interface Props {
  eyebrow: string;
  heading: string;
  support?: string;
  faqs: FAQ[];
  id?: string;
}

const { eyebrow, heading, support, faqs, id = 'faq' } = Astro.props;
---

<section class="bg-surface py-16 md:py-20" id={id}>
  <div class="mx-auto max-w-4xl px-4 md:px-6">
    <div class="text-center">
      <p class="text-xs font-bold uppercase tracking-eyebrow text-accent">{eyebrow}</p>
      <h2 class="mt-3 font-display text-4xl font-bold text-ink md:text-5xl">{heading}</h2>
      {support && <p class="mx-auto mt-4 max-w-xl text-ink-muted">{support}</p>}
    </div>

    <div class="mt-10 space-y-3">
      {faqs.map((faq, i) => (
        <details
          class="group rounded-md border border-border bg-white shadow-sm open:border-accent open:shadow-md"
          open={i === 0}
        >
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 [&::-webkit-details-marker]:hidden">
            <h3 class="font-display text-lg font-bold text-ink">{faq.question}</h3>
            <span
              class="inline-flex size-7 shrink-0 items-center justify-center rounded-full bg-surface-2 text-lg font-bold text-ink-muted transition group-open:rotate-45 group-open:bg-accent group-open:text-white"
              aria-hidden="true"
            >
              +
            </span>
          </summary>
          <p class="border-t border-border px-6 py-5 text-sm leading-relaxed text-ink-muted" set:html={faq.answer} />
        </details>
      ))}
    </div>
  </div>
</section>
