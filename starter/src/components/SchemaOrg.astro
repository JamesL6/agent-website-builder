---
/**
 * JSON-LD structured data (CORE_CONTRACTS §22 + the RGP master sheet's location schema contract).
 *
 * ONE business entity for the whole site, with a stable @id that every other node references.
 * The master sheet is explicit about this: "Reuse the verified sitewide Organization/LocalBusiness
 * entity; do not create a new business identity per city." A service-area city is never labelled as
 * a separate LocalBusiness branch.
 *
 * NOTHING HERE IS INVENTED. Every value traces to `site.ts`, which traces to the approved GBP.
 * Deliberately omitted because they are unverified or would be fabrication:
 *   · geo coordinates — no lat/lng on the approved location (§15 says a missing coord is a QA
 *     flag, not a guess)
 *   · aggregateRating / reviewCount — inventing review data is fabrication, and the review widget
 *     is still owed (B-13)
 *   · priceRange — never established
 *   · hasCredential for IICRC — proof still owed (B-12, launch_proof_required)
 */
import { site } from '../data/site';

interface Props {
  /** Absolute canonical URL of the current page. */
  url: string;
  /** Visible page title/name. */
  name: string;
  description: string;
  /** Service offered on this page, when it is a service or city-service page. */
  service?: { name: string; serviceType?: string };
  /** City this page serves, for city and city-service pages. */
  areaServedCity?: string;
  /** Breadcrumb trail matching visible navigation. */
  breadcrumbs?: { name: string; url: string }[];
  /** FAQs rendered on the page — must match the visible copy exactly. */
  faqs?: { question: string; answer: string }[];
  /** Destination pages listed on a hub, for its ItemList. */
  itemList?: { name: string; url: string }[];
  /** Emit CollectionPage instead of WebPage — city hubs and the service-area overview. */
  collection?: boolean;
  /** Emit the WebSite node. Homepage only, so it is declared once. */
  isHomepage?: boolean;
}

const {
  url, name, description, service, areaServedCity,
  breadcrumbs, faqs, itemList, collection = false, isHomepage = false,
} = Astro.props;

const ORIGIN = (Astro.site?.origin ?? site.siteUrl).replace(/\/$/, '');
const BUSINESS = `${ORIGIN}/#business`;
const loc = site.locations[0];

/** Strip HTML from FAQ answers — schema text must be plain and match what is visible. */
const plain = (s: string) => s.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();

const [street, suite, city, stateZip] = loc.address.split(',').map((p) => p.trim());
const [addrState, addrZip] = (stateZip || '').split(' ').filter(Boolean);

const business: Record<string, unknown> = {
  '@type': ['LocalBusiness', 'HomeAndConstructionBusiness'],
  '@id': BUSINESS,
  name: site.legalName,
  alternateName: site.name,
  url: `${ORIGIN}/`,
  telephone: site.phoneHref.replace('tel:', ''),
  email: site.email,
  description: site.footerBlurb,
  address: {
    '@type': 'PostalAddress',
    streetAddress: [street, suite].filter(Boolean).join(', '),
    addressLocality: city,
    addressRegion: addrState,
    postalCode: addrZip,
    addressCountry: 'US',
  },
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],
    opens: '00:00',
    closes: '23:59',
  }],
  areaServed: site.serviceArea.counties.flatMap((c) =>
    c.cities.map((ct) => ({ '@type': 'City', name: ct.name, containedInPlace: { '@type': 'AdministrativeArea', name: `${c.name}, ${site.stateName}` } })),
  ),
};
if (loc.gbpUrl) business.sameAs = [loc.gbpUrl];

const pageNode: Record<string, unknown> = {
  '@type': collection ? 'CollectionPage' : 'WebPage',
  '@id': url,
  url,
  name,
  description,
  isPartOf: { '@id': `${ORIGIN}/#website` },
  about: areaServedCity
    ? { '@type': 'City', name: areaServedCity, containedInPlace: { '@type': 'State', name: site.stateName } }
    : { '@id': BUSINESS },
  publisher: { '@id': BUSINESS },
};
if (itemList?.length) {
  pageNode.mainEntity = {
    '@type': 'ItemList',
    itemListElement: itemList.map((it, i) => ({
      '@type': 'ListItem', position: i + 1, name: it.name, url: `${ORIGIN}${it.url}`,
    })),
  };
}

const graph: Record<string, unknown>[] = [business, pageNode];

if (isHomepage) {
  graph.push({
    '@type': 'WebSite',
    '@id': `${ORIGIN}/#website`,
    url: `${ORIGIN}/`,
    name: site.name,
    publisher: { '@id': BUSINESS },
  });
}

if (service) {
  const svc: Record<string, unknown> = {
    '@type': 'Service',
    '@id': `${url}#service`,
    name: service.name,
    serviceType: service.serviceType ?? service.name,
    url,
    provider: { '@id': BUSINESS },
  };
  svc.areaServed = areaServedCity
    ? { '@type': 'City', name: areaServedCity, containedInPlace: { '@type': 'State', name: site.stateName } }
    : { '@type': 'AdministrativeArea', name: `${site.regionName}, ${site.stateName}` };
  graph.push(svc);
  if (!itemList?.length) pageNode.mainEntity = { '@id': `${url}#service` };
}

if (breadcrumbs?.length) {
  graph.push({
    '@type': 'BreadcrumbList',
    '@id': `${url}#breadcrumb`,
    itemListElement: breadcrumbs.map((b, i) => ({
      '@type': 'ListItem', position: i + 1, name: b.name, item: `${ORIGIN}${b.url}`,
    })),
  });
}

if (faqs?.length) {
  graph.push({
    '@type': 'FAQPage',
    '@id': `${url}#faq`,
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: plain(f.question),
      acceptedAnswer: { '@type': 'Answer', text: plain(f.answer) },
    })),
  });
}

const jsonld = { '@context': 'https://schema.org', '@graph': graph };
---
<script type="application/ld+json" set:html={JSON.stringify(jsonld)} is:inline />
