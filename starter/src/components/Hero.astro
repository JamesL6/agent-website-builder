---
/**
 * Emergency Split Hero — variant `image_backed_split_form` (archetype §3).
 * Left: eyebrow badge, display H1 with explicit line groups (§24), letterspaced service
 * list, 2x2 trust bullets, phone-first dual CTA (§9). Right: request-service panel.
 * All visible copy arrives via props from the Messaging Pack — no copy lives here.
 */
import type { ImageMetadata } from 'astro';
import { site } from '../data/site';
import RequestServicePanel from './RequestServicePanel.astro';
import HeroImage from './HeroImage.astro';

interface H1Line {
  text: string;
  accent?: boolean;
}

interface Props {
  eyebrow: string;
  h1Lines: H1Line[];
  serviceList: string[];
  trustBullets: string[];
  secondaryCtaLabel?: string;
  /**
   * Client hero photo (imported image). Strongly recommended — a real photo
   * behind the overlay is the single biggest difference between this reading as
   * a template and reading as a finished site. Falls back to the grid texture.
   */
  backgroundImage?: ImageMetadata;
}

const {
  eyebrow,
  h1Lines,
  serviceList,
  trustBullets,
  secondaryCtaLabel = 'Request Service',
  backgroundImage,
} = Astro.props;
---

<section class="relative overflow-hidden bg-dark text-on-dark" data-page-hero>
  {backgroundImage ? (
    <>
      {/* Real photo as an <img> (never a CSS background, §18). The photo renders
          at full opacity; contrast comes from the scrim above it, graded darkest
          on the left where the headline sits. Dimming the photo AND stacking an
          opaque gradient makes the image invisible — grade the scrim instead. */}
      <HeroImage
        src={backgroundImage}
        alt=""
        class="absolute inset-0 h-full w-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-dark/95 via-dark/80 to-dark/55" aria-hidden="true"></div>
    </>
  ) : (
    <div
      class="absolute inset-0 opacity-5"
      style="background-image: linear-gradient(to right, currentColor 1px, transparent 1px), linear-gradient(to bottom, currentColor 1px, transparent 1px); background-size: 56px 56px;"
      aria-hidden="true"
    >
    </div>
  )}

  <div class="relative mx-auto grid max-w-7xl items-start gap-10 px-4 py-12 md:px-6 md:py-16 lg:grid-cols-[minmax(0,1fr)_420px] lg:gap-14">
    <div>
      <p class="inline-flex items-center gap-2 rounded-full border border-dark-3 bg-dark-2 px-4 py-2 text-xs font-bold uppercase tracking-eyebrow text-on-dark/90">
        <svg class="size-3.5 text-accent-bright" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.2 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8L12 2z" />
        </svg>
        {eyebrow}
      </p>

      <h1 class="mt-6 font-display text-5xl font-bold leading-none sm:text-6xl xl:text-7xl">
        {h1Lines.map((line) => (
          <span class:list={['block md:whitespace-nowrap', { 'text-accent-bright': line.accent }]}>{line.text}</span>
        ))}
      </h1>

      <p class="mt-5 text-xs font-bold uppercase tracking-display text-on-dark/50 sm:text-sm">
        {serviceList.join(' · ')}
      </p>

      <ul class="mt-8 grid gap-x-8 gap-y-3 sm:grid-cols-2">
        {trustBullets.map((bullet) => (
          <li class="flex items-center gap-3 text-sm font-semibold sm:text-base">
            <span class="inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-accent" aria-hidden="true">
              <svg class="size-3 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12.5l4.5 4.5L19 7.5" />
              </svg>
            </span>
            {bullet}
          </li>
        ))}
      </ul>

      <div class="mt-9 flex flex-wrap gap-4">
        <a
          href={site.phoneHref}
          class="inline-flex items-center gap-3 rounded-md bg-accent px-7 py-4 text-lg font-bold text-white shadow-lg transition hover:bg-accent-hover"
        >
          <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z" />
          </svg>
          <span class="hidden sm:inline">Call Now — {site.phoneDisplay}</span>
          <span class="sm:hidden">Call Now</span>
        </a>
        <a
          href="#request-service"
          class="inline-flex items-center rounded-md border-2 border-on-dark/30 px-7 py-4 text-lg font-bold text-on-dark transition hover:border-on-dark/70"
        >
          {secondaryCtaLabel}
        </a>
      </div>

      <slot name="badges" />
    </div>

    <div id="request-service" class="w-full scroll-mt-24">
      <slot name="panel">
        <RequestServicePanel />
      </slot>
    </div>
  </div>
</section>
