---
/**
 * Process — variant `numbered_connector_steps`.
 * Light, airy horizontal stepper: numbered circles joined by a connector line,
 * title + copy under each step. Supports 3-5 steps. Structurally distinct from
 * the dark_timeline_cards variant. Mobile: vertical rail layout.
 */
interface Step {
  title: string;
  text: string;
}

interface Props {
  eyebrow: string;
  heading: string;
  support?: string;
  steps: Step[];
}

const { eyebrow, heading, support, steps } = Astro.props;
---

<section class="bg-white py-16 md:py-24">
  <div class="mx-auto max-w-7xl px-4 md:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-xs font-bold uppercase tracking-eyebrow text-accent">{eyebrow}</p>
      <h2 class="mt-3 font-display text-4xl font-bold text-ink md:text-5xl">{heading}</h2>
      {support && <p class="mt-4 text-ink-muted">{support}</p>}
    </div>

    <!-- Desktop: horizontal stepper -->
    <ol class="mt-14 hidden md:grid" style={`grid-template-columns: repeat(${steps.length}, minmax(0, 1fr));`}>
      {steps.map((step, i) => (
        <li class="relative px-4 text-center">
          {i > 0 && (
            <span class="absolute left-0 right-1/2 top-7 -z-0 mr-7 h-0.5 -translate-y-1/2 bg-border" aria-hidden="true"></span>
          )}
          {i < steps.length - 1 && (
            <span class="absolute left-1/2 right-0 top-7 -z-0 ml-7 h-0.5 -translate-y-1/2 bg-border" aria-hidden="true"></span>
          )}
          <span class="relative inline-flex size-14 items-center justify-center rounded-full border-2 border-accent bg-white font-display text-xl font-bold text-accent shadow-sm">
            {i + 1}
          </span>
          <h3 class="mt-5 font-display text-2xl font-bold text-ink">{step.title}</h3>
          <p class="mx-auto mt-2 max-w-xs text-sm leading-relaxed text-ink-muted">{step.text}</p>
        </li>
      ))}
    </ol>

    <!-- Mobile: vertical rail -->
    <ol class="mt-10 space-y-0 md:hidden">
      {steps.map((step, i) => (
        <li class="relative flex gap-5 pb-8 last:pb-0">
          {i < steps.length - 1 && (
            <span class="absolute bottom-0 left-6 top-12 w-0.5 -translate-x-1/2 bg-border" aria-hidden="true"></span>
          )}
          <span class="inline-flex size-12 shrink-0 items-center justify-center rounded-full border-2 border-accent bg-white font-display text-lg font-bold text-accent">
            {i + 1}
          </span>
          <div class="pt-1.5">
            <h3 class="font-display text-xl font-bold text-ink">{step.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-ink-muted">{step.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
