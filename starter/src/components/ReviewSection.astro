---
/**
 * Reviews — variants `real_widget_stacked` and `reserved_polished_state` (§16).
 * Stacked layout: intro copy above, widget full row width below — never split columns.
 * Pass the real widget embed through the `widget` slot; without it the polished
 * reserved state renders (temporary only — must be replaced before launch, §16).
 * No ratings, counts, or quotes are ever invented here (§6).
 */
import { site } from '../data/site';

interface Props {
  eyebrow: string;
  heading: string;
  intro?: string;
  /** Optional approved external reviews URL for the reserved state's outbound link. */
  reviewsUrl?: string;
  id?: string;
}

const { eyebrow, heading, intro, reviewsUrl, id = 'reviews' } = Astro.props;
const hasWidget = Astro.slots.has('widget');
---

<section class="bg-surface py-16 md:py-20" id={id}>
  <div class="mx-auto max-w-7xl px-4 md:px-6">
    <p class="text-xs font-bold uppercase tracking-eyebrow text-accent">{eyebrow}</p>
    <h2 class="mt-3 max-w-2xl font-display text-4xl font-bold text-ink md:text-5xl">{heading}</h2>
    {intro && <p class="mt-4 max-w-2xl text-ink-muted">{intro}</p>}

    <div class="mt-10 min-w-0 max-w-full overflow-hidden">
      {hasWidget ? (
        <slot name="widget" />
      ) : (
        <div class="rounded-md border border-border bg-white px-8 py-12 text-center shadow-sm">
          <svg class="mx-auto size-10 text-accent" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M9.5 7C7 7 5 9 5 11.5c0 2.1 1.4 3.9 3.4 4.4-.3 1-.9 1.9-1.9 2.6-.3.2-.4.6-.2.9.1.3.5.5.8.4 3.6-.9 6.4-4.1 6.4-8.3C13.5 9 11.7 7 9.5 7zm9 0C16 7 14 9 14 11.5c0 2.1 1.4 3.9 3.4 4.4-.3 1-.9 1.9-1.9 2.6-.3.2-.4.6-.2.9.1.3.5.5.8.4 3.6-.9 6.4-4.1 6.4-8.3C22.5 9 20.7 7 18.5 7z" />
          </svg>
          <h3 class="mt-4 font-display text-2xl font-bold text-ink">
            Hear directly from {site.name} customers
          </h3>
          <p class="mx-auto mt-2 max-w-md text-sm text-ink-muted">
            We share every review, unedited, from the platforms our customers use.
          </p>
          {reviewsUrl && (
            <a
              href={reviewsUrl}
              rel="noopener noreferrer"
              target="_blank"
              class="mt-6 inline-flex items-center gap-2 rounded-md bg-accent px-6 py-3 font-bold text-white transition hover:bg-accent-hover"
            >
              Read our reviews
              <span aria-hidden="true">→</span>
            </a>
          )}
        </div>
      )}
    </div>
  </div>
</section>
