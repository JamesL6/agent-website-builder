---
import { Icon } from 'astro-icon/components';
/**
 * Services grid — variant `icon_plus_media_cards`.
 * Icon-led light cards: accent icon tile, title, description, arrow link.
 * Structurally distinct from image_overlay_grid (no photo panels), for clients
 * with weak photography or a cleaner brand direction.
 */
interface ServiceCard {
  title: string;
  description: string;
  url: string;
  /** Built-in icon key; unknown keys fall back to the shield icon. */
  icon?: 'water' | 'fire' | 'mold' | 'storm' | 'rebuild' | 'commercial' | 'shield';
}

interface Props {
  eyebrow: string;
  heading: string;
  intro?: string;
  services: ServiceCard[];
  id?: string;
}

const { eyebrow, heading, intro, services, id = 'services' } = Astro.props;

/** Service icon keys → Lucide names (§17: Lucide only). Extend here, never with hand-drawn paths. */
const ICONS: Record<string, string> = {
  water: 'lucide:droplets',
  fire: 'lucide:flame',
  mold: 'lucide:cloud-fog',
  biohazard: 'lucide:biohazard',
  storm: 'lucide:cloud-lightning',
  rebuild: 'lucide:hammer',
  commercial: 'lucide:building-2',
  shield: 'lucide:shield',
};
---

<section class="bg-surface py-16 md:py-20" id={id}>
  <div class="mx-auto max-w-7xl px-4 md:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-xs font-bold uppercase tracking-eyebrow text-accent">{eyebrow}</p>
      <h2 class="mt-3 font-display text-4xl font-bold text-ink md:text-5xl">{heading}</h2>
      {intro && <p class="mt-4 text-ink-muted">{intro}</p>}
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((svc) => (
        <a
          href={svc.url}
          class="group rounded-md border border-border bg-white p-7 shadow-sm transition hover:-translate-y-0.5 hover:border-accent hover:shadow-md"
        >
          <span class="inline-flex size-13 items-center justify-center rounded-md bg-accent/10 p-3 text-accent transition group-hover:bg-accent group-hover:text-white">
            <Icon name={ICONS[svc.icon ?? 'shield'] ?? ICONS.shield} class="size-7" aria-hidden="true" />
          </span>
          <h3 class="mt-5 font-display text-2xl font-bold text-ink">{svc.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-muted">{svc.description}</p>
          <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-bold text-accent transition group-hover:gap-2.5">
            Learn More <span aria-hidden="true">→</span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
