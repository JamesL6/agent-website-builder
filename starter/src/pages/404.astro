---
/**
 * 404. Kept deliberately short and useful: someone here mistyped a URL or followed a dead link,
 * and on a restoration site they may be mid-emergency. Phone first, then routes back into the
 * site — every service hub (from site.services) and the service-area index.
 *
 * noindex: a 404 must never be indexed, and this stays true after launch, so it is set
 * explicitly here rather than relying on site.previewMode.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';
import { site } from '../data/site';
---

<BaseLayout
  title={`Page Not Found | ${site.name}`}
  description="That page could not be found. Call us any hour, or pick a service below."
  header="mega_menu_grouped_services"
  noindex
>
  <Image slot="logo" src={logo} alt={site.name} class="h-9 w-auto md:h-11" loading="eager" />

  <section class="bg-dark px-4 py-16 text-on-dark sm:py-24">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-xs font-bold uppercase tracking-eyebrow text-accent-bright">Error 404</p>
      <h1 class="mt-3 font-display text-4xl font-bold leading-none sm:text-5xl">This page could not be found</h1>
      <p class="mx-auto mt-4 max-w-xl text-lg text-on-dark/80">
        The link may be out of date or the address mistyped. If you have active damage, calling is
        always faster than hunting for the right page.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href={site.phoneHref}
          class="inline-flex items-center rounded-md bg-accent px-6 py-3 text-sm font-bold text-white transition hover:bg-accent-hover"
        >
          Call {site.phoneDisplay}
        </a>
        <a
          href="/"
          class="inline-flex items-center rounded-md border-2 border-on-dark/30 px-6 py-3 text-sm font-bold text-on-dark transition hover:border-on-dark/70"
        >
          Back to the homepage
        </a>
      </div>
    </div>
  </section>

  <section class="px-4 py-14 sm:py-20">
    <div class="mx-auto max-w-4xl">
      <h2 class="text-center font-display text-2xl font-bold text-ink">Where you were probably heading</h2>
      <ul class="mt-8 grid gap-3 sm:grid-cols-2">
        {[
          ...site.services.map((svc) => ({ label: svc.label, url: svc.url })),
          { label: 'Areas We Serve', url: '/service-area/' },
        ].map((l) => (
          <li>
            <a
              href={l.url}
              class="flex items-center justify-between rounded-md border border-border bg-white px-5 py-4 font-semibold text-ink shadow-sm transition hover:border-accent hover:text-accent"
            >
              {l.label}
              <span aria-hidden="true">&rarr;</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-8 text-center text-sm text-ink-muted">
        Still stuck? <a href={site.utilityNav.find((l) => l.id === 'contact')?.url ?? '/'} class="font-semibold text-accent underline">Send us a message</a>
        and we will point you in the right direction.
      </p>
    </div>
  </section>
</BaseLayout>
