---
/**
 * Variant comparison demo — "Client B" (noindex).
 *
 * Same archetype, same component library, same pipeline. Everything below differs
 * from `/` only by design-recipe choices + brand tokens + copy:
 *   hero:         premium_full_bleed          (vs. image_backed_split_form)
 *   process:      numbered_connector_steps    (vs. dark_timeline_cards)
 *   services:     icon_plus_media_cards       (vs. image_overlay_grid)
 *   service_area: regional_service_explorer   (vs. map_with_county_accordions)
 *   process steps: 5                          (vs. 3)
 *   section order: services before process; reviews last
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroFullBleed from '../components/HeroFullBleed.astro';
import RequestServicePanel from '../components/RequestServicePanel.astro';
import ServiceGridIcons from '../components/ServiceGridIcons.astro';
import ProcessStepper from '../components/ProcessStepper.astro';
import DifferentiatorVS from '../components/DifferentiatorVS.astro';
import RegionalServiceExplorer from '../components/RegionalServiceExplorer.astro';
import ReviewSection from '../components/ReviewSection.astro';
import FAQSection from '../components/FAQSection.astro';
import FinalCTA from '../components/FinalCTA.astro';
---

<BaseLayout
  title="Variant demo — Client B"
  description="Variant comparison demo: same components, different recipe and brand."
  noindex
  demoTheme="client-b"
>
  <HeroFullBleed
    eyebrow="Family owned · Serving the Puget Sound since 2009"
    h1Lines={[{ text: 'Storm and Water' }, { text: 'Damage Recovery', accent: true }, { text: 'Done Right' }]}
    subhead="When a storm opens up your roof or a pipe floods a finished basement, one local crew handles the whole recovery — mitigation, cleanup, and the rebuild."
    trustChips={['24/7 emergency crews', 'Free on-site estimates', 'Locally owned', 'Insurance documentation']}
  />

  <section class="bg-surface py-14 md:py-16" id="request-service">
    <div class="mx-auto max-w-2xl px-4 md:px-6">
      <RequestServicePanel />
    </div>
  </section>

  <ServiceGridIcons
    eyebrow="How we help"
    heading="Restoration Built Around the Damage"
    intro="Every job starts with stopping the damage, then documenting it properly, then putting the property back together."
    services={[
      { title: 'Water Damage Recovery', description: 'Extraction, structural drying, and moisture verification after floods, burst pipes, and appliance failures.', url: '/water-damage-restoration/', icon: 'water' },
      { title: 'Storm & Wind Damage', description: 'Emergency tarping, board-up, debris clearing, and full exterior recovery after Pacific storms.', url: '/storm-damage-restoration/', icon: 'storm' },
      { title: 'Fire & Smoke Cleanup', description: 'Soot removal, odor neutralization, contents handling, and rebuild coordination after a fire.', url: '/fire-damage-restoration/', icon: 'fire' },
      { title: 'Mold Remediation', description: 'Containment, safe removal, and clearance-ready documentation for homes and rentals.', url: '/mold-remediation/', icon: 'mold' },
      { title: 'Reconstruction', description: 'Drywall, flooring, paint, and finish carpentry — the same crew that dried it out puts it back.', url: '/reconstruction/', icon: 'rebuild' },
      { title: 'Commercial Property', description: 'Occupied-space containment and after-hours scheduling for offices, retail, and multifamily.', url: '/commercial-restoration/', icon: 'commercial' },
    ]}
  />

  <ProcessStepper
    eyebrow="What to expect"
    heading="Our 5-Step Recovery Process"
    support="No mystery, no surprise invoices. Here is exactly how a job runs from your first call to the final walkthrough."
    steps={[
      { title: 'Call & dispatch', text: 'A local person answers, gathers the details, and routes the nearest available crew.' },
      { title: 'On-site assessment', text: 'We find the full extent of the damage — including what is behind walls and under floors.' },
      { title: 'Stabilize & dry', text: 'Water out, containment up, drying equipment set, daily moisture readings logged.' },
      { title: 'Document the claim', text: 'Photos, readings, and a written scope your adjuster can actually work from.' },
      { title: 'Rebuild & walkthrough', text: 'Finish work completed, then we walk the property with you before we call it done.' },
    ]}
  />

  <DifferentiatorVS
    leftEyebrow="The usual experience"
    leftHeading="Why storm season goes badly"
    rightHeading="How we work instead"
    problems={[
      { title: 'Out-of-state storm chasers', text: 'Crews appear after a big storm, then disappear before the rebuild.' },
      { title: 'Drying equipment left running', text: 'Fans sit for a week with nobody checking whether the structure is actually dry.' },
      { title: 'Vague scopes', text: 'Adjusters get a one-page estimate and send it back with questions.' },
      { title: 'Two separate contractors', text: 'One company dries it out, another rebuilds — and neither owns the schedule.' },
    ]}
    answers={[
      { title: 'A local crew year-round', text: 'We live here. Our trucks are 30 minutes away in February, not just after a headline storm.' },
      { title: 'Daily moisture logs', text: 'We verify dry with meters and share the readings, then pull equipment when the numbers say so.' },
      { title: 'Adjuster-ready documentation', text: 'Photos, readings, and line-item scope submitted in the format carriers expect.' },
      { title: 'One crew start to finish', text: 'Mitigation and reconstruction under one contract, one schedule, one point of contact.' },
    ]}
  />

  <RegionalServiceExplorer
    eyebrow="Service area"
    heading="Crews Across the Puget Sound"
    intro="Search your city or browse by county. Response times vary by crew availability during major storm events."
    counties={[
      { name: 'King County', cities: [{ name: 'Seattle' }, { name: 'Bellevue' }, { name: 'Kent' }, { name: 'Renton' }, { name: 'Redmond' }, { name: 'Auburn' }] },
      { name: 'Snohomish County', cities: [{ name: 'Everett' }, { name: 'Lynnwood' }, { name: 'Marysville' }, { name: 'Arlington' }, { name: 'Edmonds' }] },
      { name: 'Skagit County', cities: [{ name: 'Mount Vernon' }, { name: 'Burlington' }, { name: 'Anacortes' }, { name: 'Sedro-Woolley' }] },
      { name: 'Whatcom County', cities: [{ name: 'Bellingham' }, { name: 'Ferndale' }, { name: 'Lynden' }, { name: 'Blaine' }] },
    ]}
    mapCenter={[47.9, -122.2]}
    mapZoom={8}
    polygon={[
      [48.9, -122.7],
      [48.9, -121.8],
      [47.9, -121.6],
      [47.3, -121.9],
      [47.3, -122.6],
      [48.2, -122.9],
    ]}
    mapCaption="Shaded service area — Puget Sound region"
  />

  <FAQSection
    eyebrow="Before you call"
    heading="Questions We Hear Every Storm Season"
    support="If water is actively running or the structure feels unsafe, skip the form and call us."
    faqs={[
      { question: 'Do you charge for an on-site estimate?', answer: 'No — on-site assessments are free, including the moisture inspection.' },
      { question: 'How long does drying usually take?', answer: 'Most residential water losses dry in three to five days. We log readings daily and pull equipment when the structure verifies dry, not on a fixed schedule.' },
      { question: 'Will you work directly with my insurance?', answer: 'Yes. We document the loss in the format carriers expect and communicate with your adjuster throughout.' },
      { question: 'Do you handle the rebuild too?', answer: 'Yes — mitigation and reconstruction are handled by the same team under one contract.' },
    ]}
  />

  <ReviewSection
    eyebrow="Neighbors we have helped"
    heading="Reviews From Around the Sound"
    intro="Unedited reviews from the platforms our customers already use."
    reviewsUrl="https://example.com/reviews"
  />

  <FinalCTA
    heading="Water Spreads Fast. Call Before It Does."
    support="Every hour of standing water means more materials to replace. Talk to a local crew now."
  />
</BaseLayout>
