---
/**
 * Full homepage assembly preview — noindex (§17). Every section of the
 * emergency_split_hero archetype rendered with realistic service-shaped
 * placeholder data standing in for a real client's Messaging Pack.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import EmergencyCTABand from '../components/EmergencyCTABand.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import DifferentiatorVS from '../components/DifferentiatorVS.astro';
import ProcessSection from '../components/ProcessSection.astro';
import ReviewSection from '../components/ReviewSection.astro';
import ServiceAreaMap from '../components/ServiceAreaMap.astro';
import FAQSection from '../components/FAQSection.astro';
import FinalCTA from '../components/FinalCTA.astro';
import { site } from '../data/site';
---

<BaseLayout
  title={`${site.name} — Starter Preview`}
  description="Agency restoration starter — full homepage assembly preview."
  noindex
>
  <Hero
    eyebrow={`#1 ${site.primaryMarket} Restoration Contractor · Residential & Commercial`}
    h1Lines={[
      { text: `${site.primaryMarket}'s` },
      { text: 'Most Trusted' },
      { text: 'Restoration', accent: true },
      { text: 'Company' },
    ]}
    serviceList={['Water', 'Fire', 'Mold', 'Storm', 'Reconstruction']}
    trustBullets={[
      '24/7 Emergency Service',
      'Fast Emergency Response',
      'Licensed & Insured',
      'Homes & Businesses',
    ]}
  />

  <EmergencyCTABand
    heading="Experiencing an Emergency Right Now?"
    support="Our team is standing by 24/7 — call now and we can start dispatch right away."
  />

  <ServiceGrid
    eyebrow="What we do"
    heading="Our Restoration Services"
    intro="From residential emergencies to commercial property losses and complete reconstruction — certified technicians and a commitment to getting you back to normal fast."
    services={[
      { title: 'Water Damage Restoration', description: 'Extraction, structural drying, and moisture documentation after floods, burst pipes, and appliance leaks.', url: '/water-damage-restoration/', chips: ['Residential', 'Commercial'] },
      { title: 'Fire Damage Restoration', description: 'Smoke and soot cleanup, odor removal, and full recovery after a fire — from first response to rebuild.', url: '/fire-damage-restoration/', chips: ['Residential', 'Commercial'] },
      { title: 'Mold Remediation', description: 'Containment, safe removal, and clearance-ready remediation with clear documentation at every step.', url: '/mold-remediation/', chips: ['Residential', 'Commercial'] },
      { title: 'Storm Damage Restoration', description: 'Emergency board-up, roof tarping, debris removal, and full property recovery after any storm.', url: '/storm-damage-restoration/' },
      { title: 'Reconstruction', description: 'Once restoration is complete, we rebuild. One contractor from disaster to done — no hand-offs, no gaps.', url: '/reconstruction/' },
      { title: 'Commercial Restoration', description: 'Fast containment, cleanup, and rebuild coordination for offices, retail, industrial, and managed facilities.', url: '/commercial-restoration/', chips: ['Commercial'] },
    ]}
  />

  <DifferentiatorVS
    leftHeading="What property owners often run into"
    rightHeading="What makes the response different"
    problems={[
      { title: 'Missed calls after hours', text: 'Emergency messages can sit until the next business day.' },
      { title: 'Limited claim support', text: 'Customers are left piecing together photos, notes, and paperwork.' },
      { title: 'Handoffs between vendors', text: 'Mitigation, cleanup, and rebuild may become separate jobs.' },
      { title: 'One narrow specialty', text: 'Some companies handle one part of the process, then leave the rest to you.' },
    ]}
    answers={[
      { title: 'Live human answering 24/7', text: 'A real person answers emergency calls and can start dispatch right away.' },
      { title: 'Fast emergency response', text: 'Emergency dispatch is prioritized so damage can be contained before it spreads.' },
      { title: 'Clear claim documentation', text: 'Photos, moisture readings, and scope notes documented from the first visit.' },
      { title: 'Mitigation through rebuild', text: 'Homes, businesses, and facilities are covered from first response to final walkthrough.' },
    ]}
  />

  <ProcessSection
    eyebrow="Simple process"
    heading="3 Steps to Restore Your Property"
    support="We've made the process simple. One call, and we handle everything — from the first response to the final nail."
    steps={[
      { title: 'Call anytime, day or night', text: 'Tell us what happened. A real person answers, asks the right questions, and gets a crew moving.' },
      { title: 'Assess & stabilize', text: 'We stop the damage from spreading, document everything for your claim, and walk you through the plan.' },
      { title: 'Restore & rebuild', text: 'From cleanup through reconstruction, one team carries your property back to normal.' },
    ]}
  />

  <ReviewSection
    eyebrow="What our customers say"
    heading={`Property owners trust ${site.name}`}
    intro="Every review comes straight from the platforms our customers use — nothing is edited or hand-picked."
  />

  <ServiceAreaMap
    eyebrow="Where we work"
    heading={`Serving ${site.primaryMarket} and Surrounding Communities`}
    intro="Fast emergency response across our core service area. Click any city to explore dedicated service pages."
    counties={[
      {
        name: 'Example County',
        cities: [
          { name: 'Example City', services: [] },
          { name: 'Northtown', services: [] },
          { name: 'Southville', services: [] },
        ],
      },
      {
        name: 'Neighbor County',
        cities: [{ name: 'Easton' }, { name: 'Westfield' }, { name: 'Lakeside' }],
      },
    ]}
    mapCenter={[41.85, -87.75]}
    mapZoom={9}
    polygon={[
      [42.15, -88.2],
      [42.2, -87.7],
      [41.85, -87.55],
      [41.5, -87.8],
      [41.6, -88.25],
    ]}
    mapCaption="Shaded service area — Example City metro"
  />

  <FAQSection
    eyebrow="Common questions"
    heading="Frequently Asked Questions"
    support="Everything you need to know before you call. Still have questions? We're available 24/7."
    faqs={[
      { question: 'Are you available 24/7?', answer: `Yes — we're available 24/7/365 for emergency restoration. Disasters don't keep business hours, and neither do we. Call <a href="${site.phoneHref}" class="font-bold text-accent">${site.phoneDisplay}</a> any time.` },
      { question: 'How fast can you get to my property?', answer: 'Emergency dispatch is prioritized across our core service area. Call and we can usually give you an arrival window on the phone.' },
      { question: 'Do you work with my insurance company?', answer: 'We document the damage thoroughly — photos, moisture readings, and scope notes — so your claim is supported from day one.' },
      { question: 'Can I request service online?', answer: 'Yes — use the request form and we\'ll respond within one business day. For active damage, calling is always fastest.' },
    ]}
  />

  <FinalCTA
    heading="Don't Wait — Damage Gets Worse Every Hour"
    support="The sooner mitigation starts, the more of your property we can save. Call now and talk to a real person."
  />
</BaseLayout>
