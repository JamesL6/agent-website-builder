---
/**
 * Template preview route (§17): mobile sticky CTA design options for owner
 * selection. Each option is rendered STATIC (not fixed) so all can be compared
 * at once. The chosen one becomes StickyMobileCTA.astro's markup.
 * Reference behavior: Romexterra = single action + status line;
 * Green State = dual action (CALL NOW + REQUEST) + copy line.
 * noindex.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';

const options = [
  {
    id: 'A',
    name: 'Single action — full width',
    note: 'Biggest possible tap target. One decision, no thinking. Current starter default.',
  },
  {
    id: 'B',
    name: 'Status line + call button (Romexterra pattern)',
    note: 'Reassurance copy earns the tap: "someone is actually there right now."',
  },
  {
    id: 'C',
    name: 'Dual action with copy line (Green State pattern)',
    note: 'Covers both intents — emergency callers and non-urgent form users.',
  },
  {
    id: 'D',
    name: 'Dual action — compact, no copy',
    note: 'Shortest bar: least screen taken, but no reassurance or urgency framing.',
  },
];

const phoneIcon =
  'M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z';
---

<BaseLayout title="Sticky mobile CTA — options" description="Internal preview." noindex>
  <section class="bg-surface py-10">
    <div class="mx-auto max-w-xl px-4">
      <p class="text-xs font-bold uppercase tracking-eyebrow text-accent">Choose one</p>
      <h1 class="mt-2 font-display text-3xl font-bold text-ink">Mobile sticky CTA options</h1>
      <p class="mt-2 text-sm text-ink-muted">
        Shown at phone width, static so you can compare. All four reveal after the hero scrolls
        past, use the approved tracking number, and respect reduced motion.
      </p>

      <div class="mt-8 space-y-10">
        {options.map((opt) => (
          <div>
            <p class="font-display text-lg font-bold text-ink">Option {opt.id} — {opt.name}</p>
            <p class="mt-1 text-sm text-ink-muted">{opt.note}</p>

            {/* phone-width frame so each option is judged at real size */}
            <div class="mt-3 rounded-lg border border-border bg-surface-2 p-3">
              <div class="mx-auto w-[366px] max-w-full">

                {opt.id === 'A' && (
                  <a href={site.phoneHref} class="flex min-h-12 items-center justify-center gap-3 rounded-md bg-accent py-3.5 text-lg font-bold text-white shadow-xl">
                    <span class="relative flex size-2.5" aria-hidden="true">
                      <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-white/70"></span>
                      <span class="relative inline-flex size-2.5 rounded-full bg-white"></span>
                    </span>
                    Need help now? Call now
                  </a>
                )}

                {opt.id === 'B' && (
                  <div class="flex items-center gap-3 rounded-md bg-dark p-3 shadow-xl">
                    <span class="relative ml-1 flex size-2.5 shrink-0" aria-hidden="true">
                      <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent-bright/70"></span>
                      <span class="relative inline-flex size-2.5 rounded-full bg-accent-bright"></span>
                    </span>
                    <p class="min-w-0 flex-1 text-sm font-bold leading-snug text-on-dark">
                      {site.emergencyAvailability} emergency service available now
                    </p>
                    <a href={site.phoneHref} class="inline-flex min-h-11 shrink-0 items-center rounded-md bg-accent px-5 font-bold text-white">
                      Call Now
                    </a>
                  </div>
                )}

                {opt.id === 'C' && (
                  <div class="rounded-md bg-dark p-3 shadow-xl">
                    <p class="flex items-center gap-2 px-1 pb-2.5 text-sm font-bold text-on-dark">
                      <span class="relative flex size-2" aria-hidden="true">
                        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent-bright/70"></span>
                        <span class="relative inline-flex size-2 rounded-full bg-accent-bright"></span>
                      </span>
                      Need help ASAP? We answer {site.emergencyAvailability}.
                    </p>
                    <div class="flex gap-2">
                      <a href={site.phoneHref} class="inline-flex min-h-11 basis-3/5 grow items-center justify-center gap-2 rounded-md bg-accent font-bold text-white">
                        <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={phoneIcon} /></svg>
                        Call Now
                      </a>
                      <a href="#request-service" class="inline-flex min-h-11 basis-2/5 grow items-center justify-center rounded-md border-2 border-on-dark/30 text-sm font-bold text-on-dark">
                        Request
                      </a>
                    </div>
                  </div>
                )}

                {opt.id === 'D' && (
                  <div class="flex gap-2 rounded-md bg-dark p-2.5 shadow-xl">
                    <a href={site.phoneHref} class="inline-flex min-h-12 basis-3/5 grow items-center justify-center gap-2 rounded-md bg-accent text-lg font-bold text-white">
                      <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={phoneIcon} /></svg>
                      Call Now
                    </a>
                    <a href="#request-service" class="inline-flex min-h-12 basis-2/5 grow items-center justify-center rounded-md border-2 border-on-dark/30 text-sm font-bold text-on-dark">
                      Request
                    </a>
                  </div>
                )}

              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
