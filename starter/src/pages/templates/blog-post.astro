---
/** Template preview route (§17): blog post through the inner-page template. noindex. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogPostTemplate from '../../components/templates/BlogPostTemplate.astro';
import InlineCTA from '../../components/InlineCTA.astro';
---
<BaseLayout title="Blog post — Template preview" description="Internal blog post template preview." noindex>
  <BlogPostTemplate
    title="What to Do in the First Hour After a Pipe Bursts"
    date="2026-01-15"
    url="/templates/blog-post/"
    intro="Shut the water off, then document before you move anything."
    blogUrl="/templates/blog/"
  >
    <h2>Stop the Water</h2>
    <p>Find the main shutoff first. Example post copy — the real article comes from the approved copy artifact.</p>
    <InlineCTA heading="Water spreading right now?" support="Call and a crew can be dispatched from that call." />
    <h2>Document Before You Move Anything</h2>
    <p>Photographs of standing water, the source, and affected contents are what your carrier works from.</p>
  </BlogPostTemplate>
</BaseLayout>
