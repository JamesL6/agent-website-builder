---
/** Template preview route (§17): service-area index — shared map with county → city hub links only, then CTA. noindex. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceAreaIndexTemplate from '../../components/templates/ServiceAreaIndexTemplate.astro';
import { site } from '../../data/site';
---
<BaseLayout title="Service Area — Template preview" description="Internal service-area index template preview." noindex>
  <ServiceAreaIndexTemplate
    eyebrow="Where we work"
    h1={`Areas ${site.name} Serves`}
    intro="Every city below has its own page with the services we offer there. If your property sits between two, call and we will tell you straight whether we can reach you."
    ctaHeading="Not sure if we cover you?"
    ctaSupport="Call and a real person will answer."
  />
</BaseLayout>
